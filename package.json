{
  "name": "@brokenbots/criteria-typescript-adapter-sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for Criteria adapter plugins - enables building workflow adapters in TypeScript",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "//version": "Placeholder. The real version is set from the release tag by .github/workflows/publish.yml (`npm version <tag>`); do not hand-bump this.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "proto/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run clean && bun scripts/gen-version.ts && tsc",
    "build:watch": "tsc --watch",
    "gen:version": "bun scripts/gen-version.ts",
    "proto:generate": "buf generate ../criteria-adapter-proto/proto",
    "proto:json": "node scripts/gen-proto-json.mjs",
    "proto:lint": "buf lint ../criteria-adapter-proto/proto",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist/",
    "example:greeter:build": "bun build --compile --target=bun-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | sed 's/x86_64/x64/' | sed 's/aarch64/arm64/') examples/greeter/index.ts --outfile examples/greeter/criteria-adapter-greeter",
    "example:greeter:run": "./examples/greeter/criteria-adapter-greeter",
    "vuln-scan": "osv-scanner scan source --config=osv-scanner.toml -r .",
    "deps:outdated": "bun outdated",
    "prepare": "bun run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.13",
    "long": "^5.2.3",
    "protobufjs": "^7.6.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "js-yaml": "^4.2.0",
    "protobufjs": "^7.6.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protoc-gen-es": "^2.2.5",
    "@connectrpc/protoc-gen-connect-es": "^1.6.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.20.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  },
  "keywords": [
    "criteria",
    "workflow",
    "adapter",
    "plugin",
    "grpc",
    "go-plugin",
    "typescript"
  ],
  "author": "brokenbots",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brokenbots/criteria-typescript-adapter-sdk.git"
  }
}
